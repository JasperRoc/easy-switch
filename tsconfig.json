{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": ".build"
  },
  "include": ["src/**/*.ts", "desktop/**/*.ts", "test/reference/*.ts"]
}
