{
  "name": "fluid",
  "version": "0.8.0",
  "description": "Switch Codex, Claude Code CLI and Claude Desktop accounts and APIs with a desktop tray app or Linux CLI",
  "type": "module",
  "bin": {
    "fd": "src/cli.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.test.json && node scripts/stage-runtime.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "npm run build && node scripts/test.ts",
    "desktop:prepare": "npm run build && node scripts/prepare-native.ts",
    "desktop:start": "npm run desktop:prepare && cargo run --manifest-path rust/desktop/Cargo.toml --features desktop --locked",
    "desktop:build:mac": "node scripts/build-desktop.ts mac",
    "desktop:build:win": "node scripts/build-desktop.ts win",
    "desktop:installer-assets": "node scripts/installer-assets.ts",
    "desktop:icons": "node scripts/icons.ts"
  },
  "files": [
    "src",
    "README.md",
    "CONTRIBUTING.md",
    "install.sh",
    "docs",
    "bin"
  ],
  "private": true,
  "dependencies": {
    "smol-toml": "^1.9.1",
    "undici": "^7.30.1",
    "yauzl": "^3.4.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "22.20.5",
    "playwright-core": "^1.64.1",
    "typescript": "5.9.3"
  },
  "author": "fluid contributors"
}
